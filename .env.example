# Copy to .env for `netlify dev`, and set the same keys in Netlify → Site configuration → Environment variables. Scope values per deploy context there if previews should use different credentials.

# Password for /admin
ADMIN_PASSWORD=
# Long random string used to sign the session cookie.
# Generate one with: `$ openssl rand -hex 32`
SESSION_SECRET=

# Cloudinary (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: top-level upload folder (defaults to "smol-cms"). Uploads go to <folder>/production or <folder>/preview.
CLOUDINARY_FOLDER=

# Optional: canonical public URL, e.g. https://example.com (defaults to the Netlify site URL)
SITE_URL=
